{
  "name": "sistema-loja-tabacaria",
  "version": "1.0.12",
  "description": "Sistema de gestão para loja de tabacaria: PVD balcão, estoque, financeiro, CRM, comissão e delivery online",
  "main": "out/main/index.js",
  "author": "Loja Tabacaria",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "npm run build:servidor && electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "servidor": "npm run build:servidor && node out/server/server/index.js",
    "relay": "npm run build:servidor && node out/server/server/relay.js",
    "test:relay": "npm run build:servidor && node --test tests/relay-permissao.test.mjs tests/relay-supervisor.test.mjs tests/relay-fluxo.test.mjs",
    "test:fila": "npm run build:servidor && node --test tests/fila-offline.test.mjs",
    "test:pedidos": "npm run build:servidor && node --test tests/pedidos-online.test.mjs",
    "test:estoque": "node --test tests/estoque-movimentacoes.test.ts",
    "test:whatsapp": "npm run build:servidor && node --test tests/whatsapp-integration.test.ts",
    "servidor:instalar": "npm run build:servidor && node scripts/instalar-servidor.js",
    "build:servidor": "tsc -p tsconfig.server.json",
    "build:servidor-exe": "tsc -p tsconfig.servidor-exe.json && node scripts/copiar-servidor-exe.js",
    "build:setup": "node scripts/download-autoupdate-node.js && tsc -p tsconfig.autoupdate.json && tsc -p tsconfig.setup.json && node scripts/compilar-setup.js",
    "build:app": "npm run build:servidor && electron-vite build",
    "package": "npm run build:servidor && electron-vite build && electron-builder --publish never",
    "package:portable": "npm run build:app && electron-builder --config electron-builder.portable.yml --publish never",
    "package:servidor": "npm run build:servidor && npm run build:servidor-exe && electron-builder --config electron-builder.servidor.yml --config.extraMetadata.main=out/servidor-exe/servidor-exe/main.js",
    "package:setup": "npm run build:app && electron-builder --config electron-builder.setup.yml --publish never",
    "package:setup:fast": "node scripts/package-setup-fast.js",
    "publicar": "node scripts/publicar-versao.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "adm-zip": "^0.6.0",
    "bcryptjs": "^2.4.3",
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "rcedit": "^5.0.2",
    "sharp": "^0.35.3",
    "unzipper": "0.12.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.3",
    "vite": "^5.4.14"
  },
  "build": {
    "appId": "br.com.lojatabacaria.sistema",
    "productName": "Sistema Loja Tabacaria",
    "directories": {
      "output": "dist-final"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node",
      "out/server/**/*",
      "out/shared/**/*"
    ],
    "extraResources": [
      {
        "from": "build/icones/servidor.ico",
        "to": "servidor.ico"
      },
      {
        "from": "src/panel-servidor",
        "to": "servidor-panel"
      }
    ],
    "win": {
      "icon": "build/icones/sistema.png",
      "target": "nsis"
    }
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true,
    "electron@43.4.0": true,
    "sharp@0.35.3": true
  }
}
